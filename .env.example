# La API de Jarvis365 (api_jarvis365), terminada en /api_jarvis/v1. Copiar a .env y poner la de verdad:
# .env no se sube a git. Ejemplo: VITE_API_URL=https://mi-api.ejemplo/api_jarvis/v1
VITE_API_URL=
# El servidor desde el que se ven las imágenes de las novedades (sin ruta). La API guarda las direcciones con su
# dominio público; si se entra por la LAN, aquí va la dirección de la LAN y el muro las reescribe.
VITE_API_URL_IMAGE=
